// Design-layer spec for CaseGraphen ADR 0016 — "a halt is a recorded reason".
//
// Source of truth for this formalization: ADR 0016 (issue #23). Every
// declaration below traces to a numbered decision in it. Nothing here invents a
// rule the ADR does not state; where the formalization forced a choice the ADR
// left open, the choice is tagged MODEL- or ASSUME- rather than REQ-.
//
// REVISION HISTORY, because two of these corrections came from the code and
// they are the reason this file is worth keeping:
//
//   1. The first version listed six halt reasons. `fslc` reported a reachable
//      deadlock — budget spent, work still dispatchable, no reason named — so
//      `RoundBudgetExhausted` became a member of the vocabulary rather than an
//      implementation detail of the loop.
//   2. The first version modelled `retry_decision` as a single external act and
//      did not model `--retry-step` as a standing flag re-applied every round,
//      which is what the CLI implemented. The proof of REQ-OPERATE-005
//      therefore did not cover the real semantics. See ASSUME-OPERATE-001.
//   3. The first version had one review seam with one clearing act. The real
//      system has two producers of `NeedsReview` with *different* exits, so
//      REQ-OPERATE-009 was proved of a machine simpler than the one built —
//      and the implementation shipped a `needs_review` naming an operation that
//      could not clear it. Now split: PendingClaimReview and PendingGateReview.
//
// Modelling bound (representation only, no behavioural content): four steps,
// one per initial shape, and a round budget of three.

spec CaseGraphenOperate {
  const MAX_ROUNDS = 3

  // A unit of work the frontier can select. `type` rather than `entity`
  // because init distinguishes the instances by index to give each halt reason
  // a reachable origin.
  type Step = 0..3

  symmetric enum Actor { A1, A2 }

  // A step's position, as the evaluator derives it. Never stored: this is the
  // model's stand-in for readiness/frontier/blockers, which CaseGraphen
  // derives.
  enum StepState {
    AwaitingExternal,
    MissingEvidence,
    OutsidePlan,
    FailedDispatch,
    Dispatchable,
    InFlight,
    PendingClaimReview,
    PendingGateReview,
    Done
  }

  // ADR 0016 decision 1: the halt vocabulary. `Progress` is the non-halt.
  enum Halt {
    Progress,
    RoundBudgetExhausted,
    NeedsReview,
    NeedsRetryDecision,
    NeedsPlanReview,
    NeedsEvidence,
    NeedsExternal,
    DispatchInProgress,
    NothingEligible
  }

  state {
    st: Map<Step, StepState>,
    dispatched_by: Map<Step, Option<Actor>>,
    reviewed_by: Map<Step, Option<Actor>>,
    // The single actor whose gate authorizes this invocation (ADR 0016 dec. 6).
    operator: Actor,
    rounds_used: 0..MAX_ROUNDS
  }

  init {
    st[0] = Dispatchable
    st[1] = MissingEvidence
    st[2] = AwaitingExternal
    st[3] = PendingGateReview
    forall s: Step {
      dispatched_by[s] = none
      reviewed_by[s] = none
    }
    operator = A1
    rounds_used = 0
  }

  def has(k: StepState) = exists s: Step { st[s] == k }

  // ADR 0016 decision 1: ONE derivation of the halt reason. It is a function of
  // state, never an assignment — which is what "derived, not recorded" means.
  // Every command that can stop reports this value; none of them re-decides it.
  //
  // `DispatchInProgress` sits immediately before `NothingEligible` on purpose:
  // it is carved out of what `NothingEligible` used to absorb. A stop because
  // another process holds a started dispatch has a reason, and reporting
  // "nothing eligible" for it satisfies the ADR's invariant only vacuously —
  // that word asserts there is no reason.
  def halt() =
    if rounds_used == MAX_ROUNDS and has(Dispatchable) then RoundBudgetExhausted
    else if has(Dispatchable) then Progress
    else if has(PendingClaimReview) or has(PendingGateReview) then NeedsReview
    else if has(FailedDispatch) then NeedsRetryDecision
    else if has(OutsidePlan) then NeedsPlanReview
    else if has(MissingEvidence) then NeedsEvidence
    else if has(AwaitingExternal) then NeedsExternal
    else if has(InFlight) then DispatchInProgress
    else NothingEligible

  // ---------------------------------------------------------------- the loop

  // ADR 0016 decision 3. The loop may only repeat the selection `run --frontier`
  // already performs: its guard is `st[s] == Dispatchable` and nothing wider.

  @requirement("REQ-OPERATE-001", "a round advances one dispatchable step and produces a claim")
  fair action round_produces(s: Step) {
    requires st[s] == Dispatchable
    requires rounds_used < MAX_ROUNDS
    st[s] = PendingClaimReview
    dispatched_by[s] = some(operator)
    rounds_used = rounds_used + 1
  }

  @requirement("REQ-OPERATE-002", "a failed dispatch ends the step's round without retrying it")
  fair action round_fails(s: Step) {
    requires st[s] == Dispatchable
    requires rounds_used < MAX_ROUNDS
    st[s] = FailedDispatch
    rounds_used = rounds_used + 1
  }

  @requirement("REQ-OPERATE-003", "a transition outside the accepted plan is kept as a proposal")
  fair action round_unauthorized(s: Step) {
    requires st[s] == Dispatchable
    requires rounds_used < MAX_ROUNDS
    st[s] = OutsidePlan
    rounds_used = rounds_used + 1
  }

  // ------------------------------------------- the acts that clear each halt
  // None of these is the loop. Each is a separate invocation carrying its own
  // gate, which is the only actor boundary the tool can observe.

  // The evidence seam: a claim the loop produced, promoted by a review
  // morphism. Cleared by `review accept`, because an evidence cell's review
  // status is log-derived.
  @requirement("REQ-OPERATE-004", "an accepted review by a different actor clears a produced claim")
  fair action review_accept(s: Step, a: Actor) {
    requires st[s] == PendingClaimReview
    requires dispatched_by[s] != some(a)
    st[s] = Done
    reviewed_by[s] = some(a)
  }

  // The gate seam: a hard `accepts` edge to a review cell that is not yet
  // accepted. This is a DIFFERENT clearing act — a review morphism changes no
  // cell state, so `review accept` cannot satisfy it; the witness cell's own
  // lifecycle must reach accepted. Modelling both as one action is what let the
  // implementation ship a halt naming an operation that did nothing.
  @requirement("REQ-OPERATE-011", "a blocking review cell is cleared by its own lifecycle, not by a review morphism")
  fair action accept_gate_cell(s: Step) {
    requires st[s] == PendingGateReview
    st[s] = Done
  }

  @requirement("REQ-OPERATE-005", "retry is an explicit act, never something the loop decides")
  fair action retry_decision(s: Step) {
    requires st[s] == FailedDispatch
    st[s] = Dispatchable
  }

  @requirement("REQ-OPERATE-006", "a plan reviewer clears NeedsPlanReview")
  fair action plan_review(s: Step) {
    requires st[s] == OutsidePlan
    st[s] = Dispatchable
  }

  @requirement("REQ-OPERATE-007", "attaching evidence clears NeedsEvidence")
  fair action evidence_attached(s: Step) {
    requires st[s] == MissingEvidence
    st[s] = Dispatchable
  }

  @requirement("REQ-OPERATE-008", "an event outside the system clears NeedsExternal")
  fair action external_event(s: Step) {
    requires st[s] == AwaitingExternal
    st[s] = Dispatchable
  }

  // ------------------------------------------------- another process's work
  // A started dispatch held by someone else. The loop cannot touch these; they
  // are why `DispatchInProgress` exists.

  @requirement("MODEL-OPERATE-008", "another process may hold a started dispatch")
  fair action other_process_starts(s: Step) {
    requires st[s] == Dispatchable
    st[s] = InFlight
  }

  @requirement("MODEL-OPERATE-009", "that dispatch may finish on its own")
  fair action other_process_finishes(s: Step) {
    requires st[s] == InFlight
    st[s] = PendingClaimReview
  }

  // ADR 0014: superseding a started dispatch is an assertion the operator
  // makes after externally establishing that dispatch is dead. Never inferred,
  // and never performed by the loop.
  @requirement("REQ-OPERATE-012", "a started dispatch is released only by an explicit assertion")
  fair action supersede_trace(s: Step) {
    requires st[s] == InFlight
    st[s] = FailedDispatch
  }

  // ------------------------------------------------------------- properties

  // ADR 0016 decision 3/4 and ADR 0002's exclusions, stated as one two-state
  // rule: whenever the loop consumed a round, the only step it touched was a
  // dispatchable one. So the loop never retries a failure, waits out an
  // external event, authorizes a transition, accepts a review, or releases
  // another process's dispatch.
  //
  // ASSUME-OPERATE-001: `retry_decision` is an act *between* invocations, never
  // one the loop performs. The CLI enforces this by refusing `--retry-step` on
  // `operate` outright, which keeps `operate`'s eligibility identical to
  // `run --frontier`'s with no exception — an operator retries with
  // `run --frontier --retry-step S` and then runs `operate`.
  //
  // A one-shot consent spent inside the loop would also satisfy this invariant,
  // and was built and tested first. It was rejected because ADR 0016 decision 3
  // says the loop "does not retry" and "does not widen eligibility" without
  // qualification, and a consent the loop spends makes both claims need a
  // footnote. An invariant that can be stated flat is worth more than the
  // convenience of one fewer command.
  //
  // Modelling `--retry-step` as a *standing* flag the loop re-applies every
  // round makes this invariant fail outright, and that is not hypothetical: the
  // CLI built it that way first, and because this file did not model the flag
  // at all, the proof of REQ-OPERATE-005 said nothing about the semantics that
  // shipped. One flag turned a single operator consent into a
  // round-budget-bounded retry engine — the alternative ADR 0002 excludes.
  @requirement("INV-OPERATE-001", "the loop advances dispatchable work and resolves no halt")
  trans LoopResolvesNoHalt {
    forall s: Step {
      (rounds_used != old(rounds_used) and st[s] != old(st[s]))
        => old(st[s]) == Dispatchable
    }
  }

  // ADR 0015 and ADR 0016 decision 4.
  //
  // **This comment used to say "the tool cannot check that two minds were
  // involved; it can check that two actor ids were, and this is that check."
  // That was false, and it is the kind of false that matters: it claimed a
  // guard the code does not provide.** Nothing in the crate compares a
  // reviewing actor against the actor that produced the claim — not
  // `native_review.rs`, not `review_apply`, not `packet resume`, which checks
  // only that a canonical accepted review exists in the log. `packet apply`
  // emits a `next_operation` note saying the review "must run under a
  // different actor's gate", but a note in a report is advice to a reader, not
  // a refusal.
  //
  // What the system actually enforces is separation **by invocation and by
  // capability**: one invocation carries one gate, `operate` never appends a
  // review morphism at all (which is what the carried test checks), and a
  // review is therefore always a second, separately gated act whose gate must
  // resolve a capability listing the `review` operation.
  //
  // In practice that refuses most self-reviews, and
  // `packet_apply_pauses_for_review_then_resume_transitions_after_acceptance`
  // shows one being refused — but read its refusal carefully: it is
  // `does not authorize operation review`, the ordinary capability check,
  // because that fixture's applying actor simply holds no review capability.
  // Nothing there compares the two actor ids. An actor whose capability lists
  // both `dispatch` and `review` reviews its own claim unrefused, and whether
  // such a grant may exist is a lift-time question — capability grants are a
  // source-boundary decision (ADR 0007).
  //
  // The distinction matters because the two protections fail differently: a
  // capability check is a statement about what an actor may do at all, and an
  // identity check would be a statement about this particular claim. Only the
  // first exists.
  //
  // So this invariant is proved of a model stricter than the system, and is
  // labelled as such rather than repaired: making the model match would mean
  // dropping `reviewed_by[s] != dispatched_by[s]`, which would delete the
  // property worth wanting. Filed as its own decision — enforce it, or state
  // in the security policy that identity separation is granted rather than
  // checked.
  @requirement("INV-OPERATE-002", "no actor accepts the claim it dispatched")
  invariant NoSelfReview {
    forall s: Step {
      (st[s] == Done and dispatched_by[s] != none)
        => (reviewed_by[s] != none and reviewed_by[s] != dispatched_by[s])
    }
  }

  // Auxiliary, for the induction proof of NoSelfReview: k-induction cannot rule
  // out a start state where a dispatched step is Done with no reviewer, because
  // nothing in NoSelfReview alone says where a dispatched step can be. Only
  // `round_produces` writes `dispatched_by` (into PendingClaimReview), and only
  // `review_accept` moves a step out of PendingClaimReview (writing
  // `reviewed_by`), so those are the only two shapes.
  @requirement("MODEL-OPERATE-011", "auxiliary: a dispatched step is pending its own review until reviewed")
  invariant DispatchedStepShape {
    forall s: Step {
      dispatched_by[s] != none
        => (st[s] == PendingClaimReview
            or (st[s] == Done and reviewed_by[s] != none))
    }
  }

  // The invariant the whole ADR exists to establish, in the direction that has
  // content: whenever the loop cannot move, some named halt says why.
  @requirement("INV-OPERATE-003", "the ledger stops only for a reason it recorded")
  invariant EveryStopIsTyped {
    (not exists s: Step { st[s] == Dispatchable and rounds_used < MAX_ROUNDS })
      => halt() != Progress
  }

  // The converse, which is what stops the vocabulary from being a way to stop
  // early: while the loop can still move, it does not get to claim a halt.
  @requirement("INV-OPERATE-004", "advancing work is never reported as a halt")
  invariant ProgressIsNotAHalt {
    (exists s: Step { st[s] == Dispatchable and rounds_used < MAX_ROUNDS })
      => halt() == Progress
  }

  // Each halt reason must be reachable, or it is dead vocabulary.
  @requirement("MODEL-OPERATE-001", "NeedsReview is reachable")
  reachable ReachNeedsReview { halt() == NeedsReview }

  @requirement("MODEL-OPERATE-002", "NeedsRetryDecision is reachable")
  reachable ReachNeedsRetry { halt() == NeedsRetryDecision }

  @requirement("MODEL-OPERATE-003", "NeedsPlanReview is reachable")
  reachable ReachNeedsPlanReview { halt() == NeedsPlanReview }

  @requirement("MODEL-OPERATE-004", "NeedsEvidence is reachable")
  reachable ReachNeedsEvidence { halt() == NeedsEvidence }

  @requirement("MODEL-OPERATE-005", "NeedsExternal is reachable")
  reachable ReachNeedsExternal { halt() == NeedsExternal }

  @requirement("MODEL-OPERATE-006", "the round budget is a halt reason, not a silent stop")
  reachable ReachBudgetExhausted { halt() == RoundBudgetExhausted }

  @requirement("MODEL-OPERATE-007", "the case can finish with everything reviewed")
  reachable ReachNothingEligible { halt() == NothingEligible }

  @requirement("MODEL-OPERATE-010", "another process's dispatch is a named stop, not nothing_eligible")
  reachable ReachDispatchInProgress { halt() == DispatchInProgress }

  // Every halt must name something that actually clears it. A halt with no exit
  // is a deadlock wearing a vocabulary word — and that is not hypothetical: the
  // implementation shipped a `needs_review` naming `review accept`, which
  // records a decision without rewriting the cell the obstruction tests, so no
  // exit existed at all.
  //
  // These are stated as reachability of the exit rather than as bounded
  // liveness on purpose, and the distinction is worth being honest about. What
  // the defect violated is that an exit exists; that is what these prove.
  // Bounded `leadsTo` over this model would additionally claim the exit is
  // taken within K steps, which fairness makes true but which BMC only
  // establishes for a K large enough to outlast every competing interleaving —
  // a number that says more about the model's size than about the design.
  //
  // Step 3 begins in `PendingGateReview` and `accept_gate_cell` is the only
  // action whose guard matches that state, so `st[3] == Done` is reachable only
  // by taking the gate seam's own exit.
  @requirement("REQ-OPERATE-009", "the gate-review seam has an exit, and it is not a review morphism")
  reachable GateReviewHasAnExit { st[3] == Done }

  // `review_accept` is the only action that writes `reviewed_by`, so a `Done`
  // step with a reviewer is reachable only by taking the claim seam's exit.
  @requirement("REQ-OPERATE-013", "the claim-review seam has an exit")
  reachable ClaimReviewHasAnExit {
    exists s: Step { st[s] == Done and reviewed_by[s] != none }
  }

  @requirement("REQ-OPERATE-010", "a failed step can be retried out of its halt")
  leadsTo RetryClears { halt() == NeedsRetryDecision ~> within 6 halt() != NeedsRetryDecision }

  // ADR 0014: the exit from an in-flight dispatch is an assertion the operator
  // makes, never an inference the tool draws, so this is reachability of the
  // asserted exit and deliberately not liveness — nothing obliges anyone to
  // supersede a trace.
  @requirement("REQ-OPERATE-014", "a started dispatch has an asserted exit")
  reachable InFlightHasAnExit {
    exists s: Step { st[s] == FailedDispatch and dispatched_by[s] == none }
  }

  // A recorded reason is a legitimate stop, and nothing else is. Written this
  // way the built-in deadlock check becomes the mechanical statement of the
  // ADR's invariant: any state where the machine stops while `halt()` still
  // says `Progress` is reported as a deadlock — that is precisely "stopped
  // because nobody pushed", and it is the thing this design removes.
  terminal { halt() != Progress }
}

verify {
}

// ------------------------------------------------------- CORRESPONDENCE
//
// This file proves a design-layer property by k-induction. `fslc verify`
// returning `proved` is a claim about the model above; it is NOT evidence
// about the shipped binary — this file's own REVISION HISTORY is the record
// of three times that distinction was not honored and a "proved" spec turned
// out to model a machine simpler than the one built (issue #37). This
// section names the real tests that carry each requirement's claim into the
// shipped code, mechanically checked by `tests/spec_correspondence.rs`,
// which parses the `@carries-test` lines below and asserts every named test
// still exists. It proves nothing about whether those tests pass, only that
// the claim "this test carries this requirement" is not stale.
//
// Marker syntax: a line `// @carries-test <TAG> <path>::<fn>` names a real
// test exercising the tagged requirement; a tag may have more than one such
// line. A line `// @carries-test <TAG> NONE` states explicitly that nothing
// in the test tree carries that requirement today.
//
// A recurring gap below is worth naming once instead of per-tag: several
// `fair action`s in this model (`plan_review`, `evidence_attached`,
// `external_event`, `accept_gate_cell`) describe a *clearing* act, and this
// repo's tests prove the *halt* those acts clear is reported correctly, but
// none of them then performs the clearing act and re-runs `operate`/`run
// --frontier` to observe the halt disappear. The halt-reporting half and the
// clearing half are different code paths, and only the first is exercised
// end-to-end today. That gap is called out explicitly at each affected tag
// rather than silently citing only the half that exists.
//
// REQ-OPERATE-001 (a round advances one dispatchable step and produces a
// claim): carried only in the weak sense that a round advances dispatchable
// work and reports a trace — every `operate_*`/`native_run_frontier_*` test
// does that. Nothing isolates the FSL's specific "claim" abstraction (an
// unreviewed inference gap on the produced evidence) as the direct result of
// one round; the claim-seam mechanism itself is what REQ-OPERATE-013's test
// carries instead.
// @carries-test REQ-OPERATE-001 PARTIAL tests/command.rs::operate_executes_two_independent_steps_then_halts_on_nothing_eligible
//
// REQ-OPERATE-002 (a failed dispatch ends the step's round without retrying
// it):
// @carries-test REQ-OPERATE-002 src/native_halt/tests.rs::a_worker_execution_failure_halts_on_needs_retry_decision
// @carries-test REQ-OPERATE-002 tests/command.rs::operate_halts_on_needs_retry_decision_after_a_worker_failure_and_stops_the_loop
//
// REQ-OPERATE-003 (a transition outside the accepted plan is kept as a
// proposal): the integration test's own name states this requirement almost
// verbatim, and checks the actual persisted `proposed.morphism.json` stays
// `unreviewed` with `transition_applied: false`.
// @carries-test REQ-OPERATE-003 tests/command.rs::native_run_step_preserves_unauthorized_transition_as_unreviewed_proposal
// @carries-test REQ-OPERATE-003 src/native_halt/tests.rs::a_transition_outside_the_accepted_plan_halts_on_needs_plan_review
//
// REQ-OPERATE-004 (an accepted review by a different actor clears a produced
// claim): not carried through `operate`/`run --frontier` itself — no test
// there drives a real claim to a halt, then runs `review accept`, then
// re-runs the loop to observe `Done`. It IS carried end to end through the
// sibling command that produces the same halt object: `packet apply` pauses
// with `halt: needs_review` naming the claim cell (the cited test's own
// comment states "packet apply's pause is a producer of the shared ADR 0016
// halt object"); the same actor's self-review is refused because its own
// capability profile does not authorize the `review` operation
// (`does not authorize operation review`) — actor-distinctness enforced by
// the capability/gate system, not a bare `dispatched_by`/`actor_id`
// comparison, which is why `grep -rn "dispatched_by\|actor_id.*!="
// src/native_review.rs` alone finds nothing; a distinct actor with review
// capability then accepts, and `packet resume` completes. This is the real
// exit REQ-OPERATE-004 describes, on the halt/review seam `operate` shares.
// @carries-test REQ-OPERATE-004 tests/command.rs::packet_apply_pauses_for_review_then_resume_transitions_after_acceptance
//
// REQ-OPERATE-011 (a blocking review cell is cleared by its own lifecycle,
// not by a review morphism): only the negative half is carried — that
// `review accept` does NOT clear this obstruction, and that `operate` itself
// never appends one (the guard is `is_clearable_by_review` in
// `src/native_halt.rs`, not itself a test). Nothing transitions the gating
// review cell's own lifecycle to `accepted` and observes the obstruction
// clear, which is the requirement's positive claim.
// @carries-test REQ-OPERATE-011 PARTIAL tests/command.rs::operate_halts_on_needs_review_and_appends_no_review_morphism
//
// REQ-OPERATE-005 (retry is an explicit act, never something the loop
// decides): this is exactly ASSUME-OPERATE-001's resolution — the CLI
// refuses `--retry-step` on `operate` outright — and the cited test's name
// states that refusal directly.
// @carries-test REQ-OPERATE-005 tests/command.rs::operate_refuses_retry_step_with_a_usage_error_and_spawns_no_worker
//
// REQ-OPERATE-006 (a plan reviewer clears NeedsPlanReview): only the halt
// half is carried — the cited test proves the halt appears. NONE carries
// the clearing act (a plan review widening `allowed_transition_classes`,
// re-run to `Dispatchable`) end to end.
// @carries-test REQ-OPERATE-006 PARTIAL tests/command.rs::native_run_step_reports_needs_plan_review_halt_for_an_unauthorized_transition
//
// REQ-OPERATE-007 (attaching evidence clears NeedsEvidence): only the halt
// half is carried. NONE carries `evidence attach --satisfies` clearing the
// obstruction and a subsequent round dispatching the step.
// @carries-test REQ-OPERATE-007 PARTIAL tests/command.rs::native_run_frontier_reports_needs_evidence_halt_when_nothing_is_dispatchable
//
// REQ-OPERATE-008 (an event outside the system clears NeedsExternal): only
// the halt half is carried. NONE carries the external-event transition
// clearing `AwaitingExternal` and a subsequent round dispatching the step.
// @carries-test REQ-OPERATE-008 PARTIAL tests/command.rs::native_run_frontier_reports_needs_external_halt_when_nothing_is_dispatchable
//
// MODEL-OPERATE-008 (another process may hold a started dispatch):
// @carries-test MODEL-OPERATE-008 src/native_halt/tests.rs::an_in_flight_dispatch_halts_on_dispatch_in_progress_instead_of_nothing_eligible
// @carries-test MODEL-OPERATE-008 tests/command.rs::native_run_frontier_supersedes_a_killed_dispatcher_trace
//
// MODEL-OPERATE-009 (that dispatch may finish on its own): the cited test
// kills the dispatching CLI process mid-round and waits for its worker
// script to write its own completion marker afterward — the dispatch
// finishing with no dispatcher left to observe it.
// @carries-test MODEL-OPERATE-009 tests/command.rs::native_run_frontier_supersedes_a_killed_dispatcher_trace
//
// REQ-OPERATE-012 (a started dispatch is released only by an explicit
// assertion): the same test drives `--supersede-trace` end to end; the
// second test is the refusal half — an invalid assertion is rejected rather
// than accepted.
// @carries-test REQ-OPERATE-012 tests/command.rs::native_run_frontier_supersedes_a_killed_dispatcher_trace
// @carries-test REQ-OPERATE-012 tests/command.rs::native_run_step_refuses_invalid_supersede_trace_assertions
//
// INV-OPERATE-001 (the loop advances dispatchable work and resolves no
// halt):
// @carries-test INV-OPERATE-001 src/native_cli/ops/run.rs::select_steps_eligibility_matches_its_own_blocking_conditions
//
// INV-OPERATE-002 (no actor accepts the claim it dispatched): as this test's
// own doc comment states, it is an outcome check through the real binary —
// drive `operate` to a `needs_review` halt, then read the persisted
// morphism log back and confirm it contains no `review` morphism at all —
// rather than a source-reading argument that would not survive a refactor.
// @carries-test INV-OPERATE-002 tests/command.rs::operate_halts_on_needs_review_and_appends_no_review_morphism
//
// MODEL-OPERATE-011 (auxiliary: a dispatched step is pending its own review
// until reviewed): an induction lemma introduced only to make the k-induction
// proof of `NoSelfReview` go through; INV-OPERATE-002 above already states
// the code-level claim it supports, and nothing in the test tree exercises
// it as an independent claim.
// @carries-test MODEL-OPERATE-011 NONE
//
// INV-OPERATE-003 (the ledger stops only for a reason it recorded) and
// INV-OPERATE-004 (advancing work is never reported as a halt): the same
