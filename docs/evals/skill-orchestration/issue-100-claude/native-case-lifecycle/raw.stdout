anged\": {\"const\": false}\n64\t  },\n65\t  \"allOf\": [\n66\t    {\"if\": {\"properties\": {\"return_required\": {\"const\": true}}}, \"then\": {\"properties\": {\"next_action\": {\"properties\": {\"kind\": {\"enum\": [\"return_for_review\", \"return_for_authority\", \"return_for_revision\"]}}}}}},\n67\t    {\"if\": {\"properties\": {\"next_action\": {\"properties\": {\"kind\": {\"const\": \"invoke_task_skill\"}}}}}, \"then\": {\"properties\": {\"next_action\": {\"properties\": {\"task_skill\": {\"type\": \"string\"}}}}}}\n68\t  ]\n69\t}\n70\t"}]},"parent_tool_use_id":null,"session_id":"4a61ca99-e520-41d9-8101-5f6aac26c72c","uuid":"21878c18-dc03-499e-b22c-18539e2a47a7","timestamp":"2026-08-06T08:40:50.908Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/2c/qtwpt9yj4fs9k20l__sg_zd40000gn/T/casegraphen-eval-native-case-lifecycle-89_zvxe_/workspace/skill/casegraphen-orchestrate/references/skill.orchestration_handoff.v0.schema.json","content":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"casegraphen.experimental.skill.orchestration_handoff.v0\",\n  \"title\": \"CaseGraphen skill orchestration handoff v0\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"schema\", \"handoff_id\", \"phase\", \"selected_task_skill\", \"selection_reason\", \"observed\", \"artifacts\", \"unresolved_evidence\", \"seams\", \"return_required\", \"next_action\", \"mutation_performed\", \"accepted_state_changed\"],\n  \"properties\": {\n    \"schema\": {\"const\": \"casegraphen.experimental.skill.orchestration_handoff.v0\"},\n    \"handoff_id\": {\"type\": \"string\", \"minLength\": 1},\n    \"phase\": {\"type\": \"string\", \"minLength\": 1},\n    \"selected_task_skill\": {\"enum\": [\"casegraphen-design\", \"casegraphen-audit\", \"casegraphen-integrate\", \"casegraphen-operate\", \"casegraphen-memory-query\", \"casegraphen-memory-curate\", \"casegraphen-memory-audit\"]},\n    \"selection_reason\": {\"type\": \"string\", \"minLength\": 1},\n    \"observed\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"case_space_id\", \"revision_id\", \"topology_content_hash\", \"report_ids\"],\n      \"properties\": {\n        \"case_space_id\": {\"type\": [\"string\", \"null\"]},\n        \"revision_id\": {\"type\": [\"string\", \"null\"]},\n        \"topology_content_hash\": {\"type\": [\"string\", \"null\"], \"pattern\": \"^sha256:[0-9a-f]{64}$\"},\n        \"report_ids\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}, \"uniqueItems\": true}\n      }\n    },\n    \"artifacts\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"path\", \"content_hash\", \"role\"],\n        \"properties\": {\n          \"path\": {\"type\": \"string\", \"minLength\": 1},\n          \"content_hash\": {\"type\": \"string\", \"pattern\": \"^sha256:[0-9a-f]{64}$\"},\n          \"role\": {\"enum\": [\"observed\", \"runtime_declared\", \"proposal\", \"accepted\"]}\n        }\n      }\n    },\n    \"unresolved_evidence\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}, \"uniqueItems\": true},\n    \"seams\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"kind\", \"status\", \"required_actor_or_policy\"],\n        \"properties\": {\n          \"kind\": {\"enum\": [\"topology_review\", \"evidence_review\", \"plan_review\", \"memory_review\", \"revision\", \"worker_enablement\", \"credential\", \"scope\", \"authority\"]},\n          \"status\": {\"enum\": [\"open\", \"satisfied\"]},\n          \"required_actor_or_policy\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"return_required\": {\"type\": \"boolean\"},\n    \"next_action\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"kind\", \"task_skill\"],\n      \"properties\": {\n        \"kind\": {\"enum\": [\"invoke_task_skill\", \"return_for_review\", \"return_for_authority\", \"return_for_revision\", \"complete\"]},\n        \"task_skill\": {\"type\": [\"string\", \"null\"], \"enum\": [null, \"casegraphen-design\", \"casegraphen-audit\", \"casegraphen-integrate\", \"casegraphen-operate\", \"casegraphen-memory-query\", \"casegraphen-memory-curate\", \"casegraphen-memory-audit\"]}\n      }\n    },\n    \"mutation_performed\": {\"const\": false},\n    \"accepted_state_changed\": {\"const\": false}\n  },\n  \"allOf\": [\n    {\"if\": {\"properties\": {\"return_required\": {\"const\": true}}}, \"then\": {\"properties\": {\"next_action\": {\"properties\": {\"kind\": {\"enum\": [\"return_for_review\", \"return_for_authority\", \"return_for_revision\"]}}}}}},\n    {\"if\": {\"properties\": {\"next_action\": {\"properties\": {\"kind\": {\"const\": \"invoke_task_skill\"}}}}}, \"then\": {\"properties\": {\"next_action\": {\"properties\": {\"task_skill\": {\"type\": \"string\"}}}}}}\n  ]\n}\n","numLines":70,"startLine":1,"totalLines":70}}}
