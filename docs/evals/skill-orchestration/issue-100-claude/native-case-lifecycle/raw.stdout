gy_proposed\",\n  \"selected_task_skill\": \"casegraphen-design\",\n  \"selection_reason\": \"The completed phase produced an unreviewed execution-topology proposal.\",\n  \"observed\": {\n    \"case_space_id\": \"case-space:issue-100\",\n    \"revision_id\": \"revision:observed\",\n    \"topology_content_hash\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n    \"report_ids\": [\"graph-lint:issue-100\"]\n  },\n  \"artifacts\": [\n    {\n      \"path\": \"execution.topology.json\",\n      \"content_hash\": \"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n      \"role\": \"proposal\"\n    }\n  ],\n  \"unresolved_evidence\": [],\n  \"seams\": [\n    {\n      \"kind\": \"topology_review\",\n      \"status\": \"open\",\n      \"required_actor_or_policy\": \"independent topology reviewer\"\n    }\n  ],\n  \"return_required\": true,\n  \"next_action\": {\"kind\": \"return_for_review\", \"task_skill\": null},\n  \"mutation_performed\": false,\n  \"accepted_state_changed\": false\n}\n","numLines":33,"startLine":1,"totalLines":33}}}
