son\": {\"type\": \"string\", \"minLength\": 1},\n    \"observed\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"case_space_id\", \"revision_id\", \"topology_content_hash\", \"report_ids\"],\n      \"properties\": {\n        \"case_space_id\": {\"type\": [\"string\", \"null\"]},\n        \"revision_id\": {\"type\": [\"string\", \"null\"]},\n        \"topology_content_hash\": {\"type\": [\"string\", \"null\"], \"pattern\": \"^sha256:[0-9a-f]{64}$\"},\n        \"report_ids\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}, \"uniqueItems\": true}\n      }\n    },\n    \"artifacts\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"path\", \"content_hash\", \"role\"],\n        \"properties\": {\n          \"path\": {\"type\": \"string\", \"minLength\": 1},\n          \"content_hash\": {\"type\": \"string\", \"pattern\": \"^sha256:[0-9a-f]{64}$\"},\n          \"role\": {\"enum\": [\"observed\", \"runtime_declared\", \"proposal\", \"accepted\"]}\n        }\n      }\n    },\n    \"unresolved_evidence\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}, \"uniqueItems\": true},\n    \"seams\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"kind\", \"status\", \"required_actor_or_policy\"],\n        \"properties\": {\n          \"kind\": {\"enum\": [\"topology_review\", \"evidence_review\", \"plan_review\", \"memory_review\", \"revision\", \"worker_enablement\", \"credential\", \"scope\", \"authority\"]},\n          \"status\": {\"enum\": [\"open\", \"satisfied\"]},\n          \"required_actor_or_policy\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"return_required\": {\"type\": \"boolean\"},\n    \"next_action\": {\n      \"type\": \"object\",\n