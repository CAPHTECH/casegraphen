{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.skill.orchestration_handoff.v0",
  "title": "CaseGraphen skill orchestration handoff v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "handoff_id", "phase", "selected_task_skill", "selection_reason", "observed", "artifacts", "unresolved_evidence", "seams", "return_required", "next_action", "mutation_performed", "accepted_state_changed"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.skill.orchestration_handoff.v0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "selected_task_skill": {"enum": ["casegraphen-design", "casegraphen-audit", "casegraphen-integrate", "casegraphen-operate", "casegraphen-memory-query", "casegraphen-memory-curate", "casegraphen-memory-audit"]},
    "selection_reason": {"type": "string", "minLength": 1},
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_space_id", "revision_id", "topology_content_hash", "report_ids"],
      "properties": {
        "case_space_id": {"type": ["string", "null"]},
        "revision_id": {"type": ["string", "null"]},
        "topology_content_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "report_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content_hash", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "role": {"enum": ["observed", "runtime_declared", "proposal", "accepted"]}
        }
      }
    },
    "unresolved_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "seams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "status", "required_actor_or_policy"],
        "properties": {
          "kind": {"enum": ["topology_review", "evidence_review", "plan_review", "memory_review", "revision", "worker_enablement", "credential", "scope", "authority"]},
          "status": {"enum": ["open", "satisfied"]},
          "required_actor_or_policy": {"type": "string", "minLength": 1}
        }
      }
    },
    "return_required": {"type": "boolean"},
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "task_skill"],
      "properties": {
        "kind": {"enum": ["invoke_task_skill", "return_for_review", "return_for_authority", "return_for_revision", "complete"]},
        "task_skill": {"type": ["string", "null"], "enum": [null, "casegraphen-design", "casegraphen-audit", "casegraphen-integrate", "casegraphen-operate", "casegraphen-memory-query", "casegraphen-memory-curate", "casegraphen-memory-audit"]}
      }
    },
    "mutation_performed": {"const": false},
    "accepted_state_changed": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"return_required": {"const": true}}},
      "then": {"properties": {"next_action": {"properties": {"kind": {"enum": ["return_for_review", "return_for_authority", "return_for_revision"]}}}}}
    },
    {
      "if": {"properties": {"next_action": {"properties": {"kind": {"enum": ["return_for_review", "return_for_authority", "return_for_revision"]}}}}},
      "then": {"properties": {"return_required": {"const": true}, "next_action": {"properties": {"task_skill": {"type": "null"}}}}}
    },
    {
      "if": {"properties": {"next_action": {"properties": {"kind": {"const": "invoke_task_skill"}}}}},
      "then": {"properties": {"return_required": {"const": false}, "next_action": {"properties": {"task_skill": {"type": "string"}}}}}
    },
    {
      "if": {"properties": {"next_action": {"properties": {"kind": {"const": "complete"}}}}},
      "then": {"properties": {"return_required": {"const": false}, "next_action": {"properties": {"task_skill": {"type": "null"}}}}}
    }
  ]
}
