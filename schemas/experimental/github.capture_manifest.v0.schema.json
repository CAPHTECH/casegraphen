{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.github.capture_manifest.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "repository", "issue_numbers", "pr_number", "captured_at", "capture_tool", "entries"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.github.capture_manifest.v0"},
    "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "issue_numbers": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "pr_number": {"type": "integer", "minimum": 1},
    "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "capture_tool": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "artifact_path", "content_hash", "command_record"],
      "properties": {
        "category": {"enum": ["issue", "pr", "files", "reviews", "review_threads", "commits", "checks"]},
        "issue_number": {"type": "integer", "minimum": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "command_record": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "if": {"properties": {"category": {"const": "issue"}}, "required": ["category"]},
      "then": {"required": ["issue_number"]},
      "else": {"not": {"required": ["issue_number"]}}
    }
  }
}
