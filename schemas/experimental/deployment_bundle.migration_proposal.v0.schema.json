{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.deployment_bundle.migration_proposal.v0",
  "title": "Deployment bundle compiler migration proposal v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_compiler_identity", "target_compiler_identity", "source_bundle_hash", "proposed_bundle_hash", "topology_content_hash", "policy_manifest_content_hash", "changed_artifact_paths", "semantic_differences", "accepted", "requires_review", "proposal_content_hash"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.deployment_bundle.migration_proposal.v0"},
    "source_compiler_identity": {"$ref": "#/$defs/compiler_migration_identity"},
    "target_compiler_identity": {"$ref": "#/$defs/compiler_migration_identity"},
    "source_bundle_hash": {"$ref": "#/$defs/sha256"},
    "proposed_bundle_hash": {"$ref": "#/$defs/sha256"},
    "topology_content_hash": {"$ref": "#/$defs/sha256"},
    "policy_manifest_content_hash": {"$ref": "#/$defs/sha256"},
    "changed_artifact_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "semantic_differences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "source", "target"],
        "properties": {
          "area": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "accepted": {"const": false},
    "requires_review": {"const": true},
    "proposal_content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiler_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation", "profile_version", "semantic_profile"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "profile_version": {"type": "integer", "minimum": 0},
        "semantic_profile": {"type": "string", "minLength": 1}
      }
    },
    "compiler_migration_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["compiler_version", "compiler_identity", "compiler_inputs_schema", "compiler_contract_versions_content_hash"],
      "properties": {
        "compiler_version": {"type": "string", "minLength": 1},
        "compiler_identity": {"$ref": "#/$defs/compiler_identity"},
        "compiler_inputs_schema": {"type": "string", "minLength": 1},
        "compiler_contract_versions_content_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
