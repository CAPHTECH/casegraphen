{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.runtime.node_report.v0",
  "title": "CaseGraphen Experimental Runtime Node Report",
  "description": "An untrusted external-runtime observation. Runtime success and reported identity, model, context, token, cost, and allocation values are not accepted CaseGraphen facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "report_id", "runtime_graph_id",
    "runtime_graph_content_hash", "node_id", "attempt_id",
    "retry_of_attempt_id", "round_id", "parent_node_ids",
    "input_artifact_ids", "output_artifact_ids",
    "expected_output_schema_id", "actual_output_schema_id", "started_at",
    "finished_at", "status", "failure_kind", "runtime_identity",
    "reported_model", "reported_context_id", "token_usage", "cost",
    "resource_allocations", "worktree_id", "commit_sha",
    "verifier_report_ids", "trust_boundary"
  ],
  "properties": {
    "schema": { "const": "casegraphen.experimental.runtime.node_report.v0" },
    "schema_version": { "const": 0 },
    "report_id": { "$ref": "#/$defs/non_empty" },
    "runtime_graph_id": { "$ref": "#/$defs/non_empty" },
    "runtime_graph_content_hash": { "$ref": "#/$defs/sha256" },
    "node_id": { "$ref": "#/$defs/non_empty" },
    "attempt_id": { "$ref": "#/$defs/non_empty" },
    "retry_of_attempt_id": { "oneOf": [{ "$ref": "#/$defs/non_empty" }, { "type": "null" }] },
    "round_id": { "$ref": "#/$defs/non_empty" },
    "parent_node_ids": { "$ref": "#/$defs/id_list" },
    "input_artifact_ids": { "$ref": "#/$defs/id_list" },
    "output_artifact_ids": { "$ref": "#/$defs/id_list" },
    "expected_output_schema_id": { "$ref": "#/$defs/non_empty" },
    "actual_output_schema_id": { "oneOf": [{ "$ref": "#/$defs/non_empty" }, { "type": "null" }] },
    "started_at": { "$ref": "#/$defs/canonical_utc_timestamp" },
    "finished_at": { "$ref": "#/$defs/canonical_utc_timestamp" },
    "status": { "enum": ["succeeded", "failed", "cancelled", "timed_out"] },
    "failure_kind": {
      "oneOf": [
        { "enum": ["execution_error", "timeout", "cancelled", "resource_exhausted", "invalid_output", "unknown"] },
        { "type": "null" }
      ]
    },
    "runtime_identity": { "$ref": "#/$defs/runtime_identity" },
    "reported_model": { "oneOf": [{ "$ref": "#/$defs/non_empty" }, { "type": "null" }] },
    "reported_context_id": { "oneOf": [{ "$ref": "#/$defs/non_empty" }, { "type": "null" }] },
    "token_usage": { "oneOf": [{ "$ref": "#/$defs/token_usage" }, { "type": "null" }] },
    "cost": { "oneOf": [{ "$ref": "#/$defs/cost" }, { "type": "null" }] },
    "resource_allocations": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource_allocation" }
    },
    "worktree_id": { "oneOf": [{ "$ref": "#/$defs/non_empty" }, { "type": "null" }] },
    "commit_sha": { "oneOf": [{ "$ref": "#/$defs/non_empty" }, { "type": "null" }] },
    "verifier_report_ids": { "$ref": "#/$defs/id_list" },
    "trust_boundary": {
      "const": "runtime_reported_untrusted_until_independently_validated_and_reviewed"
    }
  },
  "$defs": {
    "non_empty": { "type": "string", "minLength": 1 },
    "canonical_utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty" },
      "uniqueItems": true
    },
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_name", "runtime_version", "adapter_name", "adapter_version"],
      "properties": {
        "runtime_name": { "$ref": "#/$defs/non_empty" },
        "runtime_version": { "$ref": "#/$defs/non_empty" },
        "adapter_name": { "$ref": "#/$defs/non_empty" },
        "adapter_version": { "$ref": "#/$defs/non_empty" }
      }
    },
    "token_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "$ref": "#/$defs/non_empty" }
      }
    },
    "resource_allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "mode", "allocation_id"],
      "properties": {
        "resource_id": { "$ref": "#/$defs/non_empty" },
        "mode": { "$ref": "#/$defs/non_empty" },
        "allocation_id": { "$ref": "#/$defs/non_empty" }
      }
    }
  }
}
