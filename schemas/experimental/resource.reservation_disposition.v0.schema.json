{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.resource.reservation_disposition.v0",
  "title": "CaseGraphen Experimental Reservation Disposition Assertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "assertion_id", "reservation_id", "attempt_id", "kind", "asserted_by", "reason", "superseding_reservation_id"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.resource.reservation_disposition.v0"},
    "schema_version": {"const": 0},
    "assertion_id": {"$ref": "#/$defs/id"},
    "reservation_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["release", "supersede", "expire"]},
    "asserted_by": {"$ref": "#/$defs/id"},
    "reason": {"$ref": "#/$defs/id"},
    "superseding_reservation_id": {"type": ["string", "null"], "minLength": 1}
  },
  "$defs": {"id": {"type": "string", "minLength": 1}}
}
