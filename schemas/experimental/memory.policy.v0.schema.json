{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.memory.policy.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "project_id", "actor_grants", "valid_time_required_kinds", "hard_conflict_relation_types", "exact_source_escalation"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.memory.policy.v0"},
    "policy_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "actor_grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "allowed_audiences", "allowed_purposes", "project_ids", "max_sensitivity", "max_authority"],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1},
          "allowed_audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["human_review", "ai_agent", "audit", "system"]}},
          "allowed_purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "project_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "max_sensitivity": {"$ref": "casegraphen.experimental.memory.claim.v0#/$defs/sensitivity"},
          "max_authority": {"$ref": "casegraphen.experimental.memory.claim.v0#/$defs/authority"}
        }
      }
    },
    "valid_time_required_kinds": {"type": "array", "uniqueItems": true, "items": {"$ref": "casegraphen.experimental.memory.claim.v0#/$defs/memory_kind"}},
    "hard_conflict_relation_types": {
      "type": "array",
      "uniqueItems": true,
      "description": "Accepted contradicts relations whose v0 relation name is promoted to a hard conflict; v0 supports only the canonical contradicts name.",
      "items": {"const": "contradicts"}
    },
    "exact_source_escalation": {"type": "boolean"}
  }
}
