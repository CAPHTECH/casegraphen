{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.execution_topology_review.v0",
  "title": "Execution topology review binding v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "topology_id",
    "topology_content_hash",
    "case_space_id",
    "observed_base_revision_id",
    "claim_cell_id",
    "artifact_id",
    "policy_manifest_content_hash"
  ],
  "properties": {
    "schema": { "const": "casegraphen.experimental.execution_topology_review.v0" },
    "schema_version": { "const": 0 },
    "topology_id": { "$ref": "#/$defs/id" },
    "topology_content_hash": { "$ref": "#/$defs/hash" },
    "case_space_id": { "$ref": "#/$defs/id" },
    "observed_base_revision_id": { "$ref": "#/$defs/id" },
    "claim_cell_id": { "$ref": "#/$defs/id" },
    "artifact_id": { "type": "string", "pattern": "^artifact:sha256-[0-9a-f]{64}$" },
    "policy_manifest_content_hash": { "$ref": "#/$defs/hash" },
    "compiler_version": { "$ref": "#/$defs/id" },
    "compiler_semantic_profile": { "$ref": "#/$defs/id" },
    "compiler_inputs_schema": { "$ref": "#/$defs/id" },
    "compiler_contract_versions_content_hash": { "$ref": "#/$defs/hash" },
    "expansion_proposal_id": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
