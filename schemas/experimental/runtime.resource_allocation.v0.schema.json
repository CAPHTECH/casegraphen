{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.runtime.resource_allocation.v0",
  "title": "CaseGraphen Experimental Runtime Resource Allocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "allocation_id", "reservation_id", "attempt_id", "resource_id", "mode", "rate_limit_group", "rate_limit_units", "workspace_strategy", "network_scope", "secret_scope", "worktree_id", "trust_boundary"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.runtime.resource_allocation.v0"},
    "schema_version": {"const": 0},
    "allocation_id": {"$ref": "#/$defs/id"},
    "reservation_id": {"$ref": "#/$defs/id"},
    "attempt_id": {"$ref": "#/$defs/id"},
    "resource_id": {"$ref": "#/$defs/id"},
    "mode": {"enum": ["read", "write", "exclusive"]},
    "rate_limit_group": {"type": ["string", "null"], "minLength": 1},
    "rate_limit_units": {"type": "integer", "minimum": 0},
    "workspace_strategy": {"enum": ["shared", "isolated_worktree", "ephemeral", null]},
    "network_scope": {"$ref": "#/$defs/ids"},
    "secret_scope": {"$ref": "#/$defs/ids"},
    "worktree_id": {"type": ["string", "null"], "minLength": 1},
    "trust_boundary": {"const": "runtime_reported_untrusted_until_independently_reconciled"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}
  }
}
