{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.deployment_bundle.v0",
  "title": "Experimental deployment bundle manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "compiler_version", "topology_id", "topology_content_hash", "case_space_id", "base_revision_id", "mode", "policy_manifest_content_hash", "reviewed_claim_cell_id", "accepted_review_id", "accepted_review_revision_id", "artifacts"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.deployment_bundle.v0"},
    "compiler_version": {"$ref": "#/$defs/id"},
    "topology_id": {"$ref": "#/$defs/id"},
    "topology_content_hash": {"$ref": "#/$defs/hash"},
    "case_space_id": {"$ref": "#/$defs/id"},
    "base_revision_id": {"$ref": "#/$defs/id"},
    "mode": {"enum": ["proposal", "reviewed"]},
    "policy_manifest_content_hash": {"$ref": "#/$defs/hash"},
    "reviewed_claim_cell_id": {"$ref": "#/$defs/nullable_id"},
    "accepted_review_id": {"$ref": "#/$defs/nullable_id"},
    "accepted_review_revision_id": {"$ref": "#/$defs/nullable_id"},
    "artifacts": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"},
      "allOf": [
        {"contains": {"properties": {"path": {"const": "execution.topology.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "topology.content-hash"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "compiler.inputs.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "compiler.report.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "case.mapping.genesis.proposal.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "execution.plan.proposal.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "runtime.deployment.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "resource.manifest.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "verification.policies.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "budget.policies.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "expansion.policies.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"path": {"const": "graph.analysis.report.json"}}, "required": ["path"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "nullable_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "content_hash", "byte_length"],
      "properties": {
        "path": {"$ref": "#/$defs/id"},
        "content_hash": {"$ref": "#/$defs/hash"},
        "byte_length": {"type": "integer", "minimum": 0}
      }
    }
  }
}
