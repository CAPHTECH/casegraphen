{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.memory.query.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "query_id", "base_revision_id", "requesting_actor_id", "audience", "purpose", "risk_class", "as_of", "scope", "memory_kinds", "budget", "query_text"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.memory.query.v0"},
    "query_id": {"type": "string", "minLength": 1},
    "base_revision_id": {"type": "string", "minLength": 1},
    "requesting_actor_id": {"type": "string", "minLength": 1},
    "audience": {"enum": ["human_review", "ai_agent", "audit", "system"]},
    "purpose": {"type": "string", "minLength": 1},
    "risk_class": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "scope": {"$ref": "casegraphen.experimental.memory.claim.v0#/$defs/scope"},
    "memory_kinds": {"type": "array", "uniqueItems": true, "items": {"$ref": "casegraphen.experimental.memory.claim.v0#/$defs/memory_kind"}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_items", "max_tokens"],
      "properties": {"max_items": {"type": "integer", "minimum": 1}, "max_tokens": {"type": "integer", "minimum": 1}}
    },
    "query_text": {"type": "string"},
    "include_historical": {"type": "boolean", "default": false},
    "include_contested": {"type": "boolean", "default": false}
  }
}
