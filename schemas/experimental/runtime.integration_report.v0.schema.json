{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.runtime.integration_report.v0",
  "title": "Experimental runtime integration report v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "report_version", "topology_id", "topology_content_hash", "base_revision_id", "accepted", "reconciliation_complete", "halt", "completeness", "resource_reconciliations", "artifacts", "proposals", "ingest_findings"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.runtime.integration_report.v0"},
    "report_version": {"const": 0},
    "topology_id": {"$ref": "#/$defs/id"},
    "topology_content_hash": {"$ref": "#/$defs/hash"},
    "base_revision_id": {"$ref": "#/$defs/id"},
    "accepted": {"const": false},
    "reconciliation_complete": {"type": "boolean"},
    "halt": {"enum": ["incomplete_runtime_reports", "resource_reconciliation_incomplete", "needs_review"]},
    "completeness": {"$ref": "#/$defs/completeness"},
    "resource_reconciliations": {"type": "array", "items": {"$ref": "resource.reconciliation.v0.schema.json"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
    "ingest_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_finding": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "node_id", "attempt_id", "detail"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "node_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "attempt_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "detail": {"$ref": "#/$defs/id"}
      }
    },
    "edge_proof": {
      "type": "object", "additionalProperties": false,
      "required": ["edge_id", "from_node_id", "to_node_id", "output_name", "input_name", "schema_id", "delivery", "artifact_id", "artifact_content_sha256", "artifact_byte_length", "source_attempt_id", "target_attempt_id"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/id"},
        "from_node_id": {"$ref": "#/$defs/id"},
        "to_node_id": {"$ref": "#/$defs/id"},
        "output_name": {"$ref": "#/$defs/id"},
        "input_name": {"$ref": "#/$defs/id"},
        "schema_id": {"$ref": "#/$defs/id"},
        "delivery": {"enum": ["barrier", "streaming"]},
        "artifact_id": {"$ref": "#/$defs/id"},
        "artifact_content_sha256": {"$ref": "#/$defs/hash"},
        "artifact_byte_length": {"type": "integer", "minimum": 0},
        "source_attempt_id": {"$ref": "#/$defs/id"},
        "target_attempt_id": {"$ref": "#/$defs/id"}
      }
    },
    "completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_node_count", "actual_report_count", "failed_node_count", "missing_report_count", "duplicate_attempt_count", "unaccounted_artifact_count", "node_complete", "expected_edge_count", "proven_edge_count", "missing_edge_count", "dataflow_complete", "edge_proofs", "terminal_attempt_ids", "complete", "findings"],
      "properties": {
        "expected_node_count": {"type": "integer", "minimum": 0},
        "actual_report_count": {"type": "integer", "minimum": 0},
        "failed_node_count": {"type": "integer", "minimum": 0},
        "missing_report_count": {"type": "integer", "minimum": 0},
        "duplicate_attempt_count": {"type": "integer", "minimum": 0},
        "unaccounted_artifact_count": {"type": "integer", "minimum": 0},
        "node_complete": {"type": "boolean"},
        "expected_edge_count": {"type": "integer", "minimum": 0},
        "proven_edge_count": {"type": "integer", "minimum": 0},
        "missing_edge_count": {"type": "integer", "minimum": 0},
        "dataflow_complete": {"type": "boolean"},
        "edge_proofs": {"type": "array", "items": {"$ref": "#/$defs/edge_proof"}},
        "terminal_attempt_ids": {"type": "object", "additionalProperties": {"$ref": "#/$defs/id"}},
        "complete": {"type": "boolean"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/runtime_finding"}}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "sha256", "media_type", "byte_length"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/hash"},
        "media_type": {"$ref": "#/$defs/id"}, "byte_length": {"type": "integer", "minimum": 0}
      }
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "kind", "review_status", "source_boundary", "payload"],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["evidence", "morphism"]},
        "review_status": {"const": "unreviewed"}, "source_boundary": {"$ref": "#/$defs/id"},
        "payload": {}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "line", "detail"],
      "properties": {
        "code": {"$ref": "#/$defs/id"},
        "line": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "detail": {"$ref": "#/$defs/id"}
      }
    }
  }
}
