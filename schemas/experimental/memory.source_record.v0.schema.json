{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casegraphen.experimental.memory.source_record.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_record_id", "source_kind", "content_hash", "captured_at", "origin_actor_id", "source_boundary_id", "authority_origin", "sensitivity", "artifact_ref"],
  "properties": {
    "schema": {"const": "casegraphen.experimental.memory.source_record.v0"},
    "source_record_id": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["conversation", "document", "tool_output", "runtime_trace", "artifact"]},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "captured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "origin_actor_id": {"type": "string", "minLength": 1},
    "source_boundary_id": {"type": "string", "minLength": 1},
    "authority_origin": {"enum": ["user", "operator", "reviewer", "tool", "external", "inferred"]},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "artifact_ref": {"type": "string", "minLength": 1}
  }
}
