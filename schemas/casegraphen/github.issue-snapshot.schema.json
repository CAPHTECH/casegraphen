{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "highergraphen.case.github.issue_snapshot.v1",
  "title": "HigherGraphen CaseGraphen GitHub Issue Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "repository",
    "space_id",
    "query",
    "captured_at",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "highergraphen.case.github.issue_snapshot.v1"
    },
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "space_id": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "number",
        "title",
        "state"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "stateReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "milestone": {
          "oneOf": [
            {
              "$ref": "#/$defs/milestone"
            },
            {
              "type": "null"
            }
          ]
        },
        "closedByPullRequestsReferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pull_request_reference"
          }
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "closedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "body": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "type": "string"
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "title"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "dueOn": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pull_request_reference": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "number"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
