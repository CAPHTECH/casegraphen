{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "highergraphen.case.workflow.worker_binding.v1",
  "title": "CaseGraphen WorkerBinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "binding_id",
    "worker_kind",
    "command",
    "args",
    "working_directory",
    "env_allowlist",
    "timeout_ms",
    "capability_ids",
    "metadata"
  ],
  "properties": {
    "schema": {
      "const": "highergraphen.case.workflow.worker_binding.v1"
    },
    "schema_version": {
      "const": 1
    },
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_kind": {
      "enum": [
        "shell"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "working_directory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
    },
    "env_allowlist": {
      "type": "array",
      "items": {
        "type": "string",
        "allOf": [
          {
            "not": {
              "enum": [
                "PATH",
                "LD_PRELOAD",
                "LD_LIBRARY_PATH",
                "DYLD_INSERT_LIBRARIES",
                "DYLD_LIBRARY_PATH"
              ]
            }
          },
          {
            "not": {
              "pattern": "^CASEGRAPHEN_"
            }
          }
        ]
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
