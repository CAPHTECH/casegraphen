{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "highergraphen.case.native_cli.report.v1",
  "title": "Native CaseGraphen CLI Operation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_type",
    "report_version",
    "metadata",
    "input",
    "result",
    "projection"
  ],
  "properties": {
    "schema": {
      "const": "highergraphen.case.native_cli.report.v1"
    },
    "report_type": {
      "const": "native_cli_operation"
    },
    "report_version": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "tool_package",
        "core_packages"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "tool_package": {
          "const": "casegraphen"
        },
        "core_packages": {
          "type": "array",
          "contains": {
            "const": "higher-graphen-core"
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result": {
      "type": "object",
      "description": "Operation-specific native CLI result payload. The shared native operation envelope intentionally leaves most result fields broad; case history topology validates result.topology.higher_order when present, and every command that can stop (run --step, run --frontier, operate, packet apply) validates result.halt / result.halts when present.",
      "properties": {
        "topology": {
          "type": "object",
          "properties": {
            "higher_order": {
              "$ref": "#/$defs/higher_order_topology"
            }
          }
        },
        "halt": {
          "description": "ADR 0016: the single highest-priority halt reason this invocation stopped for, or null while progress remained possible. The head of result.halts.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/halt_report"
            }
          ]
        },
        "halts": {
          "type": "array",
          "description": "ADR 0016: every independently-true halt reason this invocation found, in the same priority order as result.halt. A case can have more than one true reason at once (one step needing a retry decision while another needs plan review); this is the full list, never re-derivable from result.halt alone.",
          "items": {
            "$ref": "#/$defs/halt_report"
          }
        }
      }
    },
    "projection": {
      "$ref": "#/$defs/projection_bundle"
    }
  },
  "$defs": {
    "halt_report": {
      "type": "object",
      "description": "ADR 0016 (docs/adr/0016-a-halt-is-a-recorded-reason.md): a resumable object naming why the ledger stopped, derived once in src/native_halt.rs and reported by every command that can stop, never assembled by any of them independently.",
      "additionalProperties": false,
      "required": [
        "halt",
        "completed_through",
        "target_ids",
        "next_operations"
      ],
      "properties": {
        "halt": {
          "type": "string",
          "enum": [
            "round_budget_exhausted",
            "needs_review",
            "needs_retry_decision",
            "needs_plan_review",
            "needs_evidence",
            "needs_external",
            "dispatch_in_progress",
            "nothing_eligible"
          ]
        },
        "completed_through": {
          "type": "string",
          "minLength": 1,
          "description": "The revision id the ledger completed through before stopping."
        },
        "target_ids": {
          "type": "array",
          "description": "The witness id(s) the halt is about -- the thing an operator must act on (e.g. the unsatisfied requirement id for needs_evidence, the blocking review cell for needs_review), not merely the cell the obstruction affects. Empty for round_budget_exhausted and nothing_eligible, which name nothing.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/next_operation"
          }
        }
      }
    },
    "next_operation": {
      "type": "object",
      "description": "A structured suggestion for the operation that would clear a halt -- named argument values a caller passes verbatim, never a command string assembled by concatenation. That distinction exists because a packet- or case-controlled id (e.g. claim.id) interpolated into an assembled string could inject flags into the very command a halt's next_operations exists to name safely (issue #19).",
      "additionalProperties": false,
      "required": [
        "command",
        "arguments",
        "note"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object",
          "description": "Named argument values for `command`, e.g. {\"target_id\": \"...\", \"base_revision_id\": \"...\"}.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "projection_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_review",
        "ai_view",
        "audit_trace"
      ],
      "properties": {
        "human_review": {
          "type": "object"
        },
        "ai_view": {
          "type": "object"
        },
        "audit_trace": {
          "type": "object"
        }
      }
    },
    "higher_order_topology": {
      "type": "object",
      "description": "Optional higher-order topology diagnostics emitted only when --higher-order is supplied to native case history topology.",
      "required": [
        "options",
        "cell_count",
        "stage_count"
      ],
      "properties": {
        "options": {
          "type": "object",
          "required": [
            "include_higher_order",
            "min_persistence_stages"
          ],
          "properties": {
            "include_higher_order": {
              "const": true
            },
            "max_dimension": {
              "type": "integer",
              "minimum": 0
            },
            "min_persistence_stages": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cell_count": {
          "type": "integer",
          "minimum": 0
        },
        "stage_count": {
          "type": "integer",
          "minimum": 0
        },
        "persistence": {
          "$ref": "#/$defs/persistence_summary"
        },
        "omitted_reason": {
          "type": "string"
        }
      }
    },
    "persistence_summary": {
      "type": "object",
      "required": [
        "complex_id",
        "options",
        "stages",
        "intervals",
        "persistent_intervals",
        "open_component_count",
        "open_hole_count"
      ],
      "properties": {
        "complex_id": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "object",
          "required": [
            "min_lifetime_stages"
          ],
          "properties": {
            "min_lifetime_stages": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filtration_stage_summary"
          }
        },
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/persistence_interval"
          }
        },
        "persistent_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/persistence_interval"
          }
        },
        "open_component_count": {
          "type": "integer",
          "minimum": 0
        },
        "open_hole_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "filtration_stage_summary": {
      "type": "object",
      "required": [
        "stage_id",
        "stage_index",
        "cell_ids",
        "topology"
      ],
      "properties": {
        "stage_id": {
          "type": "string",
          "minLength": 1
        },
        "stage_index": {
          "type": "integer",
          "minimum": 0
        },
        "cell_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "topology": {
          "type": "object"
        }
      }
    },
    "persistence_interval": {
      "type": "object",
      "required": [
        "dimension",
        "birth_stage_id",
        "birth_stage_index",
        "generator_cell_ids"
      ],
      "properties": {
        "dimension": {
          "type": "integer",
          "minimum": 0
        },
        "birth_stage_id": {
          "type": "string",
          "minLength": 1
        },
        "birth_stage_index": {
          "type": "integer",
          "minimum": 0
        },
        "death_stage_id": {
          "type": "string",
          "minLength": 1
        },
        "death_stage_index": {
          "type": "integer",
          "minimum": 0
        },
        "generator_cell_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
